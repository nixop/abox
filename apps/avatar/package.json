{
  "name": "avatar",
  "private": true,
  "type": "module",
  "description": "Runway realtime avatar fronting kagent agents, with a memory loop through memory-eval-both and memory-writer",
  "scripts": {
    "server": "node server.ts",
    "dev": "vite",
