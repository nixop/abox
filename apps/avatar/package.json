  "engines": { "node": ">=22.6" },
  "dependencies": {
    "@runwayml/avatars-node-rpc": "^0.1.0",
    "@runwayml/avatars-react": "^0.17.0",
    "@runwayml/sdk": "^4.21.0",
    "express": "^4.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
